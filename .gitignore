Intermediate/
Saved/
Build/*
!Build/**/*.png
!Build/**/*.ico

# 플러그인 빌드 산출물
Plugins/**/Binaries/
Plugins/**/Intermediate/

# 생성되는 IDE 프로젝트 파일 (.uproject에서 재생성)
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace

